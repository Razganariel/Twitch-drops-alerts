# PostgreSQL
# Les identifiants doivent correspondre à ceux définis dans docker-compose.yml
POSTGRES_USER="PLACE_HOLDER"
POSTGRES_PASSWORD="PLACE_HOLDER"
POSTGRES_DB="PLACE_HOLDER"
DATABASE_URL="postgresql://PLACE_HOLDER:PLACE_HOLDER@localhost:5432/PLACE_HOLDER?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# URL publique de l'application (utilisée dans les API callbacks)
APP_URL="http://localhost:3000"

# Email admin pour les notifications système (compte de service expiré, etc.)
ADMIN_EMAIL="admin@example.com"

# Twitch OAuth (console développeur : https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Encryption (utilisé pour chiffrer les champs sensibles en base)
# Générer avec: openssl rand -hex 32
ENCRYPTION_KEY=""

# Redis (utilisé uniquement pour les files d'attente, optionnel)
REDIS_URL="redis://localhost:6379"

# Email — Resend (prioritaire) ou SMTP
# Laisser RESEND_API_KEY vide pour utiliser SMTP
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Twitch Drops Alerts <noreply@example.com>"
