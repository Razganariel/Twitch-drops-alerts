services:
  postgres:
    container_name: twitch-drops-postgres
    image: docker.io/library/postgres:16
    environment:
      POSTGRES_USER: PLACE_HOLDER_USER
      POSTGRES_PASSWORD: PLACE_HOLDER_PASSWORD
      POSTGRES_DB: PLACE_HOLDER_DB
    ports:
      - "5432:5432"
    volumes:
      - ./pgdata:/var/lib/postgresql/data:Z
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U PLACE_HOLDER_USER -d PLACE_HOLDER_DB"]
      interval: 5s
      timeout: 5s
      retries: 5
    restart: unless-stopped
    mem_limit: 512m

  redis:
    container_name: twitch-drops-redis
    image: docker.io/library/redis:7-alpine
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 5
    restart: unless-stopped
    mem_limit: 128m

  app:
    container_name: twitch-drops-alerts
    build:
      context: .
      target: app-runner
    ports:
      - "3330:3330"
    environment:
      - PORT=3330
      - DATABASE_URL=postgresql://PLACE_HOLDER_USER:PLACE_HOLDER_PASSWORD@postgres:5432/PLACE_HOLDER_DB?schema=public
    env_file: .env
    dns:
      - 8.8.8.8
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    restart: on-failure:5
    mem_limit: 256m

  worker:
    container_name: twitch-drops-worker
    build:
      context: .
      target: worker-runner
    environment:
      - DATABASE_URL=postgresql://PLACE_HOLDER_USER:PLACE_HOLDER_PASSWORD@postgres:5432/PLACE_HOLDER_DB?schema=public
    env_file: .env
    dns:
      - 8.8.8.8
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    restart: on-failure:5
    mem_limit: 256m
