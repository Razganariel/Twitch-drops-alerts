generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SyncAccount {
  id           String    @id @default(cuid())
  service      String    @unique
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  updatedAt    DateTime  @updatedAt
}

enum AlertStatus {
  SENT
  READ
}

enum DashboardFilter {
  ALL
  MATCH
}

enum DashboardView {
  GRID
  LIST
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailHash     String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  timezone        String?
  checkInterval   Int              @default(15)
  lastMatchAt     DateTime?
  dashboardFilter DashboardFilter  @default(MATCH)
  dashboardView   DashboardView    @default(GRID)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  twitchConnection TwitchConnection?
  steamConnection  SteamConnection?
  userGames        UserGame[]
  twitchFollowedGames TwitchFollowedGame[]
  alerts           Alert[]
  otpCodes         OtpCode[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TwitchConnection {
  id                String   @id @default(cuid())
  userId            String   @unique
  twitchId          String?
  twitchLogin       String?
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  gqlAccessToken    String?
  gqlRefreshToken   String?
  gqlTokenExpiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SteamConnection {
  id          String   @id @default(cuid())
  userId      String   @unique
  steamId     String
  steamApiKey String
  lastSyncedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Game {
  id         String @id @default(cuid())
  steamAppId Int    @unique
  name       String
  logoUrl    String?

  userGames UserGame[]
  alerts    Alert[]
}

model UserGame {
  userId         String
  gameId         String
  isAlertEnabled Boolean   @default(true)
  deletedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
}

model TwitchFollowedGame {
  id           String   @id @default(cuid())
  userId       String
  twitchGameId String
  gameName     String
  boxArtUrl    String?
  followedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, twitchGameId])
}

model DropItem {
  id                     String   @id @default(cuid())
  twitchDropId           String
  name                   String
  rewardName             String?
  rewardImageUrl         String?
  requiredMinutesWatched Int?
  sortOrder              Int      @default(0)

  twitchDrop TwitchDrop @relation(fields: [twitchDropId], references: [id], onDelete: Cascade)

  @@index([twitchDropId])
}

model TwitchDrop {
  id                     String   @id @default(cuid())
  campaignId             String   @unique
  twitchGameId           String
  gameName               String
  gameBoxArtUrl          String?
  campaignName           String
  rewardName             String?
  requiredMinutesWatched Int?
  startAt                DateTime
  endAt                  DateTime
  isActive               Boolean  @default(true)

  alerts Alert[]
  dropItems DropItem[]
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  purpose   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Alert {
  id     String      @id @default(cuid())
  userId String
  gameId String
  dropId String
  sentAt DateTime    @default(now())
  status AlertStatus @default(SENT)

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  drop TwitchDrop @relation(fields: [dropId], references: [id], onDelete: Cascade)
}
